# --- n8n ---
# Encrypts stored credentials. Any long random string; keep it the same across restarts.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=UTC
# The workflow reads the URLs below through $env, which n8n blocks unless this is "false".
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Where the workflows send data (defaults: the mock services) ---
# From inside Docker the mocks are at http://mock-services:4000 (docker-compose.yml sets that).
# These values are for running n8n directly on your machine.
ENRICH_API_URL=http://127.0.0.1:4000
CRM_API_URL=http://127.0.0.1:4000
SLACK_SALES_WEBHOOK_URL=http://127.0.0.1:4000/slack/hooks/sales-hot
SLACK_OPS_WEBHOOK_URL=http://127.0.0.1:4000/slack/hooks/ops-alerts

# API keys the mocks accept. In n8n they live in credentials (n8n/demo-credentials.json),
# never in the workflow file.
ENRICH_API_KEY=mock-enrich-key
CRM_API_KEY=mock-crm-key

# --- Mock services and demo form ---
PORT=4000
# The browser posts the demo form here.
FORM_WEBHOOK_URL=http://localhost:5678/webhook/lead-capture
# Optional: your Make scenario's webhook URL, adds "Make" to the form's target menu.
MAKE_WEBHOOK_URL=
# Share of requests each mock answers with 503 (0 to 1).
MOCK_ENRICH_FAILURE_RATE=0
MOCK_CRM_FAILURE_RATE=0
MOCK_SLACK_FAILURE_RATE=0
MOCK_LATENCY_MS=80
BATCH_INSERT=enabled
COMPUTE_METRICS=enabled
PING_SERVICE=enabled
HASH_PASSWORD=enabled